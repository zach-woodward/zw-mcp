# ---------------------------------------------------------------------------
# ZW MCP configuration. Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# --- MCP transport -----------------------------------------------------------
# Port the always-on server listens on (launchd plist assumes 8787).
PORT=8787
# Bind address.
#   127.0.0.1  local clients only (Claude Code / Desktop on this machine)
#   0.0.0.0    reachable from the LAN, so MCP clients on other machines can
#              connect. Safe because every /mcp request still requires the
#              ZW_MCP_TOKEN bearer -- that is what the token is for.
HOST=0.0.0.0
# Shared secret every MCP client must send as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
ZW_MCP_TOKEN=
LOG_LEVEL=info

# --- DocuSign environment ----------------------------------------------------
# demo | prod. Flips every product base URI and the auth server in one move.
DS_ENVIRONMENT=demo

# Integration key (client ID) from Settings -> Apps and Keys.
DS_INTEGRATION_KEY=

# GUID of the user to impersonate (Apps and Keys -> "User ID", NOT the account ID).
DS_USER_ID=

# Path to the RSA PRIVATE key generated for that integration key.
# Keep it outside git; *.pem is gitignored.
DS_RSA_PRIVATE_KEY_PATH=./keys/docusign_private.pem

# Optional. Auto-discovered from /oauth/userinfo when blank; set it to pin a
# specific account when the impersonated user belongs to several.
DS_ACCOUNT_ID=

# Optional override of the auth host. Leave blank -- DS_ENVIRONMENT picks
# account-d.docusign.com (demo) or account.docusign.com (prod).
DS_AUTH_SERVER=

# Product APIs to enable, comma separated. Drives both the consent scope union
# and which tools get registered. A scope your account is not entitled to fails
# the WHOLE consent grant, so add products as you verify entitlement.
# Known: esign,navigator,clm,maestro,webforms,rooms,click,admin,monitor,notary,
#        connectedfields,workspaces,trustrecords
DS_PRODUCTS=esign

# Where downloaded documents are written. Tools return paths under here rather
# than base64 blobs.
DOWNLOAD_DIR=./downloads

# --- Admin console (separate app; see README "Admin console") ---
# ADMIN_PORT=8788
# ADMIN_BIND=127.0.0.1          # 0.0.0.0 to expose on the LAN
# ADMIN_PASSWORD=               # set to require HTTP Basic auth
# ADMIN_USER=zw
# ADMIN_ALLOW_INSECURE=         # 1 = deliberately run without auth off-loopback
