<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zw.mcp.admin</string>

  <!-- The admin console. Separate from com.zw.mcp on purpose: the MCP server is
       the product, this is an operator tool, and either can be restarted alone. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/zwmacminiai/dev/zw-mcp/dist/admin/server.js</string>
  </array>

  <!-- Must be the project root: .env and admin/public are both resolved from here. -->
  <key>WorkingDirectory</key>
  <string>/Users/zwmacminiai/dev/zw-mcp</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/zwmacminiai/dev/zw-mcp/logs/launchd.admin.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zwmacminiai/dev/zw-mcp/logs/launchd.admin.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>NODE_ENV</key>
    <string>production</string>

    <!-- Reachable from the LAN at http://ZWs-Mac-mini.local:8788
         ADMIN_ALLOW_INSECURE=1 is the explicit acknowledgement that this console
         has no password. It can send and void envelopes, so if this account ever
         stops being a demo account, set ADMIN_PASSWORD here and drop this flag. -->
    <key>ADMIN_BIND</key>
    <string>0.0.0.0</string>
    <key>ADMIN_ALLOW_INSECURE</key>
    <string>1</string>
  </dict>
</dict>
</plist>
